    {
      "parameters": {
        "jsCode": "const q = $json.query || {};\nconst allowed = { qr: 'qr_scan', pv: 'page_view', demo: 'demo_engaged', lpc: 'lp_contact_session' };\nconst event_type = allowed[q.ev];\nconst pid = String(q.pid || '').replace(/[^a-z0-9]/gi, '').slice(0, 32);\nconst sid = String(q.sid || '').replace(/[^a-z0-9_-]/gi, '').slice(0, 64);\nif (!event_type || !pid || !sid) return { json: { skip: true } };\nconst path = String(q.path || '/').slice(0, 300);\nreturn { json: {\n  lookup: `token=eq.${pid}`, event_type, session_id: sid, path, source: 'website_pixel',\n  first_in_session: q.first === '1', occurred_at: new Date().toISOString(),\n  key_suffix: event_type === 'page_view' ? `pv:${sid}:${path}` : `${event_type}:${sid}`, payload: {},\n} };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        -300
      ],
      "id": "94f29888-191f-4457-92c2-771b883e57b7",
      "name": "Normalize Pixel"
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst map = { email_sent: 'email_sent', email_opened: 'email_opened', link_clicked: 'email_clicked',\n  email_link_clicked: 'email_clicked', reply_received: 'email_replied', email_bounced: 'email_bounced',\n  lead_unsubscribed: 'unsubscribed' };\nconst event_type = map[b.event_type];\nconst email = String(b.lead_email || b.email || '').trim().toLowerCase();\nif (!event_type || !email) return { json: { skip: true } };\nconst step = b.step ?? '';\nconst ts = b.timestamp || new Date().toISOString();\nconst once = { email_opened: `open:${b.campaign_id}:${step}`, email_sent: `sent:${b.campaign_id}:${step}` };\nreturn { json: {\n  lookup: `email=eq.${encodeURIComponent(email)}`, event_type, session_id: null, path: null, source: 'instantly',\n  first_in_session: false, occurred_at: ts,\n  key_suffix: once[event_type] || `${event_type}:${b.campaign_id}:${step}:${ts}`,\n  payload: { campaign_id: b.campaign_id, step, link_url: b.link_url || b.url || '', reply_text: b.reply_text_snippet || b.reply_text || '' },\n} };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        -100
      ],
      "id": "bcf77a57-a05a-49e1-93ad-60e719edf02b",
      "name": "Normalize Instantly"
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst mp = b.MessageProperty;\nconst raw = String(b.domain || b.website || (mp ? (mp[0] ?? mp['0'])?.PropValue : '') || '').toLowerCase();\nconst domain = raw.replace(/^[a-z]+:\\/\\//, '').replace(/^www\\./, '').split(/[\\/?#]/)[0];\nif (!/\\.[a-z]{2,}$/.test(domain)) return { json: { skip: true } };\nconst hour = new Date().toISOString().slice(0, 13);\nreturn { json: {\n  lookup: `company_domain=eq.${encodeURIComponent(domain)}`, event_type: 'account_visit', session_id: null, path: null,\n  source: 'factors', first_in_session: false, occurred_at: new Date().toISOString(), key_suffix: `acct:${hour}`, payload: { domain },\n} };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
