    {
      "parameters": {
        "jsCode": "const now = new Date().toISOString();\nreturn $input.all().map(({ json: s }) => ({ json: {\n  row: { id: s.id, intent_score: s.score, intent_tier: s.tier, score_updated_at: now },\n  hubspot_contact_id: s.hubspot_contact_id || '',\n  score: s.score, tier: s.tier, previous_tier: s.previous_tier,\n  newly_sales_ready: ['Hot', 'Warm'].includes(s.tier) && !s.sales_ready_at,\n  first_name: s.first_name, last_name: s.last_name || '', company_name: s.company_name, email: s.email,\n  signals: [s.qr_visit && 'QR landing', s.demo && 'demo engaged', s.lp_to_contact && 'QR session to contact page',\n            s.visits_14d >= 3 && `${s.visits_14d} visits in 14 days`, s.visited && 'website visit'].filter(Boolean),\n} }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -150
      ],
      "id": "dea60e6a-79a0-465d-a1df-c4b6910bbc92",
      "name": "Plan Score Updates"
    },
    {
