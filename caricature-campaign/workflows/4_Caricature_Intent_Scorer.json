        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: Object.assign({ hs_timestamp: $now.plus({ hours: 2 }).toUTC().toISO(), hs_task_subject: `Sales ready (${$('Newly Sales Ready?').item.json.tier}, ${$('Newly Sales Ready?').item.json.score}/100): call ${$('Newly Sales Ready?').item.json.first_name} at ${$('Newly Sales Ready?').item.json.company_name}`, hs_task_body: `Signals in the last 30 days: ${$('Newly Sales Ready?').item.json.signals.join(', ')}. Cold call and push for an office visit or ${$('Load Config').first().json.meet_location}. Use the caricature as the opener.`, hs_task_status: 'NOT_STARTED', hs_task_priority: 'HIGH', hs_task_type: 'CALL' }, $('Load Config').first().json.hubspot_owner_id ? { hubspot_owner_id: $('Load Config').first().json.hubspot_owner_id } : {}) }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
