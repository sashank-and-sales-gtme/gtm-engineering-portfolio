        "jsCode": "const s = $('Newly Sales Ready?').item.json;\nreturn { json: { prospect_id: s.row.id, event_type: 'sales_ready', event_key: `${s.row.id}:sales_ready:${new Date().toISOString().slice(0, 10)}`,\n  source: 'scorer', payload: { score: s.score, tier: s.tier } } };",
