        },
        "text": "={{ $('Decide Transition').item.json.action === 'delivered' ? `📬 Caricature delivered to ${$('Decide Transition').item.json.first_name} at ${$('Decide Transition').item.json.company_name}. Delivery email goes out in 4 hours; first call on Day 2.` : `↩️ Caricature for ${$('Decide Transition').item.json.first_name} at ${$('Decide Transition').item.json.company_name} was not delivered (${$('Decide Transition').item.json.status_label}). Rejection sequence starts now.` }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
