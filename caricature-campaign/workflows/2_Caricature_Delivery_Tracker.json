{
  "name": "Caricature 2 - Delivery Tracker",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "caricature-ship24",
        "options": {},
        "authentication": "headerAuth"
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        -100
      ],
      "id": "68ea9995-9b24-4788-8e02-24ad8b8af2f7",
      "name": "Ship24 Webhook",
      "webhookId": "f82151de-9cd5-460e-9126-890de7d9001f"
    },
    {
      "parameters": {
        "formTitle": "Caricature delivery confirmation",
        "formDescription": "Use this for couriers without API tracking. Pick the prospect email and the outcome.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Prospect email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Outcome",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Delivered"
                  },
                  {
                    "option": "Returned or refused"
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "path": "caricature-delivery-confirm"
        }
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        100
      ],
      "id": "faa64a0a-9f23-4fa6-8db8-c43fded8f748",
      "name": "Manual Delivery Form",
      "webhookId": "caricature-delivery-confirm"
    },
    {
      "parameters": {
        "jsCode": "const body = $('Ship24 Webhook').first().json.body || {};\nconst trackings = Array.isArray(body.trackings) ? body.trackings : [];\nconst out = [];\nfor (const t of trackings) {\n  const tracker = t.tracker || {};\n  const shipment = t.shipment || {};\n  const events = Array.isArray(t.events) ? t.events : [];\n  const latest = events\n    .slice()\n    .sort((a, b) => String(b.occurrenceDatetime || b.datetime || '').localeCompare(String(a.occurrenceDatetime || a.datetime || '')))[0] || {};\n  const milestone = shipment.statusMilestone || latest.statusMilestone || '';\n  const code = latest.statusCode || shipment.statusCode || '';\n  let outcome = 'update';\n  if (milestone === 'delivered') outcome = 'delivered';\n  else if (milestone === 'exception' || code === 'delivery_refused') outcome = 'not_delivered';\n  out.push({\n    tracking_number: tracker.trackingNumber || '',\n    email: '',\n    outcome,\n    status_label: `${milestone || 'unknown'}${code ? ` (${code})` : ''}`,\n    occurred_at: latest.occurrenceDatetime || latest.datetime || new Date().toISOString(),\n    source: 'ship24',\n  });\n}\nreturn out.filter((o) => o.tracking_number).map((json) => ({ json }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        -100
      ],
      "id": "5f366eb9-3dd8-4043-a15f-1ae4bf37d34a",
      "name": "Parse Ship24"
    },
    {
      "parameters": {
        "jsCode": "const f = $json;\nreturn {\n  json: {\n    tracking_number: '',\n    email: String(f['Prospect email'] || '').trim().toLowerCase(),\n    outcome: f['Outcome'] === 'Delivered' ? 'delivered' : 'not_delivered',\n    status_label: `manual: ${f['Outcome']}`,\n    occurred_at: new Date().toISOString(),\n    source: 'manual_form',\n  },\n};",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
      ],
      "id": "def077c7-551a-49a4-8cd4-2017938a6887",
      "name": "Parse Form"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "id": "ef7b6abf-230e-4582-95d1-2d7d26fd35c5",
      "name": "Delivery Signal"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "campaign_config",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {}
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "id": "02c627bd-e548-4b44-bdd5-fcf2e1933ae0",
      "name": "Load Config"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "prospects",
        "returnAll": true,
        "filterType": "string",
        "filterString": "={{ $('Delivery Signal').item.json.tracking_number ? 'tracking_number=eq.' + encodeURIComponent($('Delivery Signal').item.json.tracking_number) : 'email=eq.' + encodeURIComponent($('Delivery Signal').item.json.email) }}"
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        880,
        0
      ],
      "id": "7098f553-895d-4db5-8187-73ef31da571d",
      "name": "Find Prospect",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const sig = $('Delivery Signal').item.json;\nconst row = $json;\nif (!row.id) return { json: { action: 'unmatched', sig } };\nconst open = ['shipped', 'untracked'].includes(row.track);\nlet action = 'ignore';\nif (open && sig.outcome === 'delivered') action = 'delivered';\nelse if (open && sig.outcome === 'not_delivered') action = 'not_delivered';\nelse if (sig.outcome === 'update') action = 'update';\nconst day1 = new Date(sig.occurred_at);\nconst day1Iso = isNaN(day1) ? new Date().toISOString() : day1.toISOString();\nconst enroll = new Date(new Date(day1Iso).getTime() + (action === 'delivered' ? 4 * 3600 * 1000 : 0)).toISOString();\nreturn {\n  json: {\n    action,\n    id: row.id,\n    hubspot_contact_id: row.hubspot_contact_id,\n    first_name: row.first_name,\n    company_name: row.company_name,\n    email: row.email,\n    status_label: sig.status_label,\n    source: sig.source,\n    day1_at: day1Iso,\n    enroll_at: enroll,\n    new_track: action === 'delivered' ? 'delivered_not_scanned' : action === 'not_delivered' ? 'not_delivered' : row.track,\n  },\n};",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "id": "9f0beb9a-9ac9-48c8-a0ec-2d9be685b362",
      "name": "Decide Transition"
    },
    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 3,
        "output": "={{ ['delivered', 'not_delivered'].includes($json.action) ? 0 : $json.action === 'update' ? 1 : $json.action === 'unmatched' ? 2 : 3 }}"
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1320,
        0
      ],
      "id": "1d2c6c8d-8385-464c-83a2-aeff7a3198a5",
      "name": "Route"
    },
    {
      "parameters": {
        "jsCode": "return { json: { id: $json.id, track: $json.new_track, day1_at: $json.day1_at, enroll_at: $json.enroll_at } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -200
      ],
      "id": "b05c661d-bc0b-4c02-a5b3-7a39e0c0a7b6",
      "name": "Stage Row"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "prospects",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "dataToSend": "autoMapInputData"
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1760,
        -200
      ],
      "id": "75c38528-148b-488c-8a14-b8e376d2f3a1",
      "name": "Update Stage"
    },
    {
      "parameters": {
        "jsCode": "const d = $('Decide Transition').item.json;\nreturn { json: { prospect_id: d.id, event_type: d.action, occurred_at: d.day1_at, event_key: `${d.id}:${d.action}`, source: d.source } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -200
      ],
      "id": "d2b2e0d4-8cc2-4228-b608-6298d0882c75",
      "name": "Stage Event"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "events",
        "dataToSend": "autoMapInputData"
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2200,
        -200
      ],
      "id": "757139e9-ebf5-422e-bc37-14fe41683861",
      "name": "Log Stage Event",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/{{ $('Decide Transition').item.json.hubspot_contact_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: { caricature_stage: $('Decide Transition').item.json.action === 'delivered' ? 'Delivered' : 'Not delivered', caricature_day1_date: $('Decide Transition').item.json.day1_at.slice(0, 10) } }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2420,
        -200
      ],
      "id": "c8c485a0-2e19-43c9-a5c4-fa303dbed30d",
      "name": "HubSpot: Stage Properties",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/notes",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: { hs_timestamp: $now.toISO(), hs_note_body: `Caricature ${$('Decide Transition').item.json.action === 'delivered' ? 'delivered' : 'not delivered (returned or refused)'}. Day 1 = ${$('Decide Transition').item.json.day1_at.slice(0, 10)}. Source: ${$('Decide Transition').item.json.source} (${$('Decide Transition').item.json.status_label}).` } }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
