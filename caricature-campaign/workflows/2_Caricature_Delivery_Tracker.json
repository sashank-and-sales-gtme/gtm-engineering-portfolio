    },
    {
      "parameters": {
        "jsCode": "return { json: { prospect_id: $json.id, event_type: 'delivery_update', occurred_at: $json.day1_at,\n  event_key: `${$json.id}:update:${$json.status_label}:${$json.day1_at}`, source: $json.source, payload: { status: $json.status_label } } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
