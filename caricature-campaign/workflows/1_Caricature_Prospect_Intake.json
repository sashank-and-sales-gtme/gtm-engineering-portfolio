      "parameters": {
        "authentication": "accessToken",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Load Config').first().json.slack_channel_id }}"
        },
        "text": "={{ `📦 Caricature intake: ${$json.created_count} added, ${$json.failed_count} failed${$json.tracker_errors ? `, ${$json.tracker_errors} tracker errors (check Ship24)` : ''}\\n\\n` + $json.created.map(c => `• ${c.company} (${c.email}) | ${c.track === 'untracked' ? 'manual delivery confirmation needed' : 'tracked via Ship24'}\\n   QR: ${c.qr_png_url}`).join('\\n') + ($json.failed.length ? `\\n\\nFailed:\\n` + $json.failed.map(f => `• ${f.error}`).join('\\n') : '') }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
