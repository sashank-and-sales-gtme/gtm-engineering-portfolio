      "name": "Intake Webhook",
      "webhookId": "3a02484a-62c5-4a7b-9c12-fe1b980ee23c"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "campaign_config",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {}
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "id": "6b8fdd37-03a7-43be-9296-42e7a12fc57f",
      "name": "Load Config"
    },
    {
      "parameters": {
        "jsCode": "const body = $('Intake Webhook').first().json.body || {};\nconst list = Array.isArray(body.prospects) ? body.prospects : [body];\nconst UNTRACKED = ['', 'doordash', 'dunzo', 'porter', 'swiggy genie', 'uber', 'other', 'hand delivery'];\nconst slugify = (s) => String(s).toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');\nconst problems = [];\nconst out = list.map((p, i) => {\n  const email = String(p.email || '').trim().toLowerCase();\n  const first = String(p.first_name || p.firstName || '').trim();\n  const company = String(p.company_name || p.orgName || p.company || '').trim();\n  if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) problems.push(`row ${i + 1}: invalid email \"${p.email || ''}\"`);\n  if (!first) problems.push(`row ${i + 1}: first_name missing`);\n  if (!company) problems.push(`row ${i + 1}: company_name missing`);\n  const carrier = String(p.carrier || '').trim().toLowerCase();\n  const tracking = String(p.tracking_number || '').trim();\n  const domain = String(p.company_domain || email.split('@')[1] || '').toLowerCase().replace(/^www\\./, '');\n  return {\n    email, first_name: first, last_name: String(p.last_name || p.lastName || '').trim(),\n    title: String(p.title || '').trim(), company_name: company, company_slug: slugify(company),\n    company_domain: domain, carrier, tracking_number: tracking,\n    trackable: Boolean(tracking) && !UNTRACKED.includes(carrier),\n  };\n});\nif (problems.length) throw new Error(`Intake rejected. ${problems.join('; ')}`);\nreturn out.map((json) => ({ json }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "e1891ba2-ebd7-4b64-bf02-133ac49be88c",
      "name": "Normalize Prospects"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/batch/upsert",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ inputs: [{ idProperty: 'email', id: $json.email, properties: { email: $json.email, firstname: $json.first_name, lastname: $json.last_name, jobtitle: $json.title, company: $json.company_name, caricature_stage: 'Shipped' } }] }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "id": "b0adf629-1b7e-44e6-984e-adc08fa724fb",
      "name": "HubSpot: Upsert Contact"
    },
    {
      "parameters": {
        "jsCode": "const p = $('Normalize Prospects').item.json;\nconst row = {\n  email: p.email, first_name: p.first_name, last_name: p.last_name || null, title: p.title || null,\n  company_name: p.company_name, company_slug: p.company_slug, company_domain: p.company_domain || null,\n  hubspot_contact_id: String($json.results?.[0]?.id ?? ''),\n  carrier: p.carrier || null,\n  track: p.trackable ? 'shipped' : 'untracked',\n};\nif (p.tracking_number) row.tracking_number = p.tracking_number;\nreturn { json: row };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "329d4ac2-3f0b-4867-be1f-bbc8cac16b80",
