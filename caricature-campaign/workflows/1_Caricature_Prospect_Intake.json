      "name": "Collect Results"
    },
    {
      "parameters": {
        "jsCode": "const created = $('Build Links').all().map((i) => {\n  const row = $('Create Prospect').all().find((r) => r.json.id === i.json.id)?.json || {};\n  return { email: row.email, company: row.company_name, track: row.track, lp_url: i.json.lp_url, qr_png_url: i.json.qr_png_url };\n});\nlet failed = [];\ntry {\n  failed = $('Prospect Created?').all(1).map((i) => ({ error: i.json.error?.message || i.json.message || 'insert failed (duplicate email or tracking number?)' }));\n} catch (e) { failed = []; }\nconst trackers = (() => { try { return $('Ship24: Create Tracker').all(); } catch (e) { return []; } })();\nconst trackerErrors = trackers.filter((t) => t.json.error).length;\nreturn [{ json: { created, failed, tracker_errors: trackerErrors, created_count: created.length, failed_count: failed.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3760,
