      "id": "ffd86aac-b50b-45e0-9284-66da9e55e194",
      "name": "Prospect Created?"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Load Config').first().json;\nconst base = String(cfg.website_base_url || 'https://interactlabs.ai').replace(/\\/+$/, '');\nconst qs = new URLSearchParams({\n  utm_source: 'direct_mail',\n  utm_medium: 'caricature_doll',\n  utm_campaign: `${$json.company_slug}_outreach`,\n  utm_content: $json.token,\n});\nconst lp_url = `${base}/?${qs.toString()}`;\nconst qr_png_url = `https://api.qrserver.com/v1/create-qr-code/?size=1000x1000&margin=20&data=${encodeURIComponent(lp_url)}`;\nreturn { json: { id: $json.id, lp_url, qr_png_url } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -100
      ],
