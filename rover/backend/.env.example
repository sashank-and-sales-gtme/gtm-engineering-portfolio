# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Required. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

DATABASE_URL=sqlite:///./rover.db
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=30

# n8n public API (Settings > n8n API). Leave empty to store connections without handing them to n8n.
N8N_API_URL=
N8N_API_KEY=

# OAuth apps. Register the redirect URI {FRONTEND_URL}/oauth/callback with each provider.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Zoho data centre: https://accounts.zoho.com, https://accounts.zoho.in, https://accounts.zoho.eu
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
